---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { websiteJsonLd } from '../lib/structured-data';
import FormattedDate from '../components/FormattedDate.astro';

const posts = await getCollection('blog');
const featured = posts.find((post) => post.id === 'human-in-the-loop-sem-design-de-interacao');

if (!featured) {
	throw new Error('Post em destaque HITL não encontrado.');
}

const featuredSummary = featured.data.summary;
if (!featuredSummary) {
	throw new Error('O post em destaque precisa de um resumo para leitores.');
}

const recent = posts
	.filter((post) => post.id !== featured.id)
	.sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf() || a.id.localeCompare(b.id),
	)
	.slice(0, 5);
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<JsonLd
			data={websiteJsonLd({
				name: SITE_TITLE,
				description: SITE_DESCRIPTION,
				url: new URL('/', Astro.site).href,
			})}
		/>
		<style>
			.lede {
				font-size: 1.15rem;
				line-height: 1.6;
			}
			.featured-card {
				display: block;
				margin: 0 0 1.75rem;
				padding: 1.35rem 1.4rem 1.2rem;
				background: var(--brand-paper);
				border: 1px solid var(--brand-line);
				border-radius: var(--radius);
				text-decoration: none;
				color: inherit;
			}
			.featured-card:hover {
				border-color: var(--brand-navy);
			}
			.featured-card:focus-visible {
				outline: 2px solid var(--brand-navy);
				outline-offset: 3px;
			}
			.featured-kicker {
				margin: 0 0 0.55rem;
				font-size: var(--fs-meta);
				letter-spacing: 0.04em;
				text-transform: uppercase;
				color: var(--brand-muted);
			}
			.featured-card h2 {
				margin: 0 0 0.55rem;
				font-size: 1.35rem;
				line-height: 1.25;
				color: var(--brand-navy-ink);
			}
			.featured-card p {
				margin: 0;
				color: var(--brand-muted);
				font-size: 1rem;
				line-height: 1.5;
			}
			.featured-card .more {
				display: inline-block;
				margin-top: 0.9rem;
				color: var(--brand-navy);
				font-weight: 700;
				font-size: 0.95rem;
			}
			.recent h2 {
				margin: 0 0 1rem;
				font-size: 1.35rem;
			}
			.post-list {
				list-style: none;
				padding: 0;
				margin: 0 0 1.75rem;
				display: grid;
				gap: var(--s-5);
			}
			.post-list a {
				display: block;
				color: var(--brand-navy-ink);
				font-weight: 700;
				text-decoration: none;
			}
			.post-list a:hover {
				color: var(--brand-navy);
				text-decoration: underline;
			}
			.post-list :global(time) {
				display: block;
				margin-top: 0.3rem;
				font-size: var(--fs-meta);
				color: var(--brand-muted);
			}
			.post-list p {
				margin: 0.35rem 0 0;
				color: var(--brand-muted);
				font-size: 1rem;
				line-height: 1.5;
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="conteudo" tabindex="-1">
			<h1>Humberto Sardenberg</h1>
			<p class="lede">
				Este é um blog sobre <strong>produto de IA</strong>, <strong>HITL</strong> (human-in-the-loop) e <strong>interaction design</strong> — com foco em decisões de produto, qualidade de experiência e o papel do humano em sistemas inteligentes.
			</p>
			<a class="featured-card" href={`/blog/${featured.id}/`}>
				<p class="featured-kicker">Em destaque</p>
				<h2>{featured.data.title}</h2>
				<p>{featuredSummary}</p>
				<span class="more">Ler o artigo</span>
			</a>
			<section class="recent" aria-labelledby="posts-recentes">
				<h2 id="posts-recentes">Posts recentes</h2>
				<ul class="post-list">
					{
						recent.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>{post.data.title}</a>
								<FormattedDate date={post.data.pubDate} />
								<p>{post.data.summary ?? post.data.description}</p>
							</li>
						))
					}
				</ul>
			</section>
			<p>
				<a href="/blog">Ver todos os posts →</a>
			</p>
		</main>
		<Footer />
	</body>
</html>
