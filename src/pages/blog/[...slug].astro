---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { blogPostingJsonLd, breadcrumbListJsonLd } from '../../lib/structured-data';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await render(post);
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = post.data.heroImage
	? new URL(post.data.heroImage.src, Astro.url).href
	: undefined;
const jsonLd = [
	blogPostingJsonLd({
		title: post.data.title,
		description: post.data.description,
		pubDate: post.data.pubDate,
		updatedDate: post.data.updatedDate,
		pageUrl,
		imageUrl,
	}),
	breadcrumbListJsonLd({
		title: post.data.title,
		pageUrl,
	}),
];
---

<BlogPost {...post.data} jsonLd={jsonLd}>
	<Content />
</BlogPost>
