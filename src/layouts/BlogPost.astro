---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import ArticleLightbox from '../components/ArticleLightbox.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE_AUTHOR } from '../consts';

type Heading = { depth: number; slug: string; text: string };
type Neighbor = { href: string; title: string };

type Props = CollectionEntry<'blog'>['data'] & {
	jsonLd?: unknown[];
	readingMinutes?: number;
	headings?: Heading[];
	newer?: Neighbor | null;
	older?: Neighbor | null;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	jsonLd,
	readingMinutes,
	headings = [],
	newer = null,
	older = null,
} = Astro.props;
const enableLightbox = Astro.url.pathname.startsWith('/blog/');
const toc = headings.filter((heading) => heading.depth === 2);
const showArticleMeta = typeof readingMinutes === 'number';
---

<html lang="pt-BR">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={heroImage}
			ogType="article"
			publishedTime={pubDate}
		/>
		{jsonLd?.map((data) => <JsonLd data={data} />)}
		<style>
			.hero-image {
				width: 100%;
				margin-bottom: 1.5rem;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: var(--radius);
			}
			.title {
				margin-bottom: 1.5rem;
				padding: 0.25rem 0 0;
				text-align: left;
			}
			.title h1 {
				margin: 0;
			}
			.meta {
				margin: 0.85rem 0 0;
				font-size: var(--fs-meta);
				line-height: 1.4;
				color: var(--brand-muted);
			}
			.sep {
				margin: 0 0.4rem;
			}
			.last-updated-on {
				font-style: italic;
			}
			.title hr {
				margin: 1.25rem 0 0;
			}
		</style>
	</head>

	<body>
		<Header />
		<div class:list={['article-shell', { 'has-toc': toc.length > 0 }]}>
			<div class="article-column">
				<main id="conteudo" tabindex="-1">
					<article>
						{
							heroImage && (
								<div class="hero-image">
									<Image width={1020} height={510} src={heroImage} alt={title} />
								</div>
							)
						}
						<div class="prose">
							<div class="title">
								<h1>{title}</h1>
								<p class="meta">
									<FormattedDate date={pubDate} />
									{
										showArticleMeta && (
											<>
												<span class="sep" aria-hidden="true">
													·
												</span>
												<span>{readingMinutes} min de leitura</span>
												<span class="sep" aria-hidden="true">
													·
												</span>
												<span>{SITE_AUTHOR}</span>
											</>
										)
									}
									{
										updatedDate && (
											<span class="last-updated-on">
												{' '}
												· Atualizado em <FormattedDate date={updatedDate} />
											</span>
										)
									}
								</p>
								<hr />
							</div>
							<slot />
						</div>
						{
							(older || newer) && (
								<nav class="post-pager" aria-label="Mais artigos">
									{
										older && (
											<a class="post-pager__prev" rel="prev" href={older.href}>
												<span>Anterior</span>
												{older.title}
											</a>
										)
									}
									{
										newer && (
											<a class="post-pager__next" rel="next" href={newer.href}>
												<span>Próximo</span>
												{newer.title}
											</a>
										)
									}
								</nav>
							)
						}
					</article>
				</main>
			</div>
			{
				toc.length > 0 && (
					<nav class="toc" aria-label="Neste artigo">
						<p class="toc-title">Neste artigo</p>
						<ol>
							{toc.map((heading) => (
								<li>
									<a href={`#${heading.slug}`}>{heading.text}</a>
								</li>
							))}
						</ol>
					</nav>
				)
			}
		</div>
		<Footer />
		{enableLightbox && <ArticleLightbox />}
	</body>
</html>
